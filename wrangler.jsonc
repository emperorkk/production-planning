{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "production-planning",
  // Cloudflare account: ONECODE Support
  "account_id": "af6abc318e022147698714a45b9ba92e",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static Assets: everything under ./public is served by the Worker via env.ASSETS.
  // run_worker_first=true → the Worker runs for EVERY request, so it can auth-gate pages.
  // html_handling=none    → /login.html is served as-is (default "auto-trailing-slash"
  //                          redirects it to /login, which looped with the Worker's redirect).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },

  // KV namespace for session storage (clientID + user context per session cookie).
  // To be created on the ONECODE Support account AFTER the Worker is created:
  //   npx wrangler kv namespace create SESSIONS
  // Then paste the id below.
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "2bf8852d955c4bcbb1def4e4d3ccef37"
    }
  ],

  // Non-secret config.
  "vars": {
    "SOFT1_API_URL": "https://01104398142024.oncloud.gr/s1services",
    "SOFT1_APP_ID":  "1199",              // access 'full'       (Προγραμματισμός + Διαχείριση παραγωγής)
    "SOFT1_APP_ID_PRODUCTION": "1200",   // access 'production' (Διαχείριση παραγωγής only)
    // Empty = fall back to the first company/branch returned by Soft1 /login
    "SOFT1_COMPANY": "",
    "SOFT1_BRANCH":  "",
    // Custom AJS web service (soft1/Foxline.planning.js) → <SOFT1_API_URL>/JS/<script>/<fn>
    "SOFT1_JS_SCRIPT": "Foxline.planning"
  },

  "observability": {
    "enabled": true
  }
}
